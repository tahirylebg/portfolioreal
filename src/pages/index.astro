---
import '../styles/global.css';
import { certifications, currentTraining, education, experience, profile, projects, skillGroups } from '../data/portfolio.js';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101310" />
    <meta name="description" content="Portfolio de Tahiry Ramambazafy, étudiant en cybersécurité. Projets en sécurité web, OSINT et infrastructure Linux." />
    <title>{profile.name} — Cybersécurité & infrastructures</title>
    <link rel="canonical" href="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.name} — Cybersécurité & infrastructures`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/" />
    <meta property="og:title" content="Tahiry Ramambazafy — Cybersécurité & infrastructures" />
    <meta property="og:description" content="Portfolio d'un étudiant en cybersécurité : sécurité web, OSINT, Linux, Ansible. Comprendre. Sécuriser. Construire." />
    <meta property="og:image" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Tahiry Ramambazafy — Comprendre. Sécuriser. Construire." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tahiry Ramambazafy — Cybersécurité & infrastructures" />
    <meta name="twitter:description" content="Portfolio d'un étudiant en cybersécurité : sécurité web, OSINT, Linux, Ansible. Comprendre. Sécuriser. Construire." />
    <meta name="twitter:image" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/og-image.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <aside class="scroll-gauge" aria-hidden="true">
      <span class="scroll-gauge-track"><i class="scroll-gauge-fill"></i></span>
      <span class="scroll-gauge-readout" data-scroll-readout>00%</span>
      <nav class="scroll-gauge-ticks">
        <a href="#accueil" data-gauge="accueil"></a>
        <a href="#profil" data-gauge="profil"></a>
        <a href="#projets" data-gauge="projets"></a>
        <a href="#parcours" data-gauge="parcours"></a>
        <a href="#contact" data-gauge="contact"></a>
      </nav>
    </aside>
    <header class="site-header" data-site-header>
      <a class="brand" href="#accueil" aria-label="Accueil, Tahiry Ramambazafy">
        <span class="brand-mark" aria-hidden="true"><span class="brand-letter">T</span><span class="brand-axis"></span><span class="brand-dot"></span></span>
        <span class="brand-name">TAHIRY RAMAMBAZAFY</span>
      </a>
      <nav class="main-nav" aria-label="Navigation principale">
        <a href="#projets" data-section-link="projets">Projets</a>
        <a href="#parcours" data-section-link="parcours">Parcours</a>
        <a href="#contact" data-section-link="contact">Contact</a>
      </nav>
      <a class="header-availability" href="#contact"><span class="availability-dot"></span><span>Ouvert aux échanges</span><span class="availability-arrow" aria-hidden="true">↗</span></a>
    </header>

    <main id="contenu">
      <section class="hero" id="accueil" aria-labelledby="hero-title" data-scroll-section>
        <div class="hero-gridline" aria-hidden="true" data-parallax="0.08"></div>
        <div class="hero-copy" data-parallax="0.18">
          <p class="hero-overline"><span class="signal-dot"></span> {profile.role} <span class="overline-divider">/</span> Ynov</p>
          <h1 id="hero-title">Comprendre.<br />Sécuriser<span class="hero-period">.</span><br /><span class="hero-outline">Construire.</span></h1>
          <p class="hero-focus">{profile.focus}</p>
          <p class="hero-summary">{profile.summary}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projets">Explorer mes projets <span class="button-icon" aria-hidden="true">↘</span></a>
            <a class="text-link" href="/cv-tahiry-ramambazafy.pdf" target="_blank" rel="noreferrer">Voir mon CV <span class="link-arrow" aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-index"><span>31° 36′ 48.0″ S</span><span class="index-rule"></span><span>43° 40′ 48.0″ E</span></div>
        </div>

        <div class="hero-art-parallax" data-hero-parallax>
        <div class="hero-art" aria-label="Visualisation abstraite de connexions réseau">
          <div class="art-topline"><span>OBSERVATION SYSTÈME</span><span>EN DIRECT <i></i></span></div>
          <div class="network-stage">
            <canvas class="network-canvas" aria-hidden="true"></canvas>
            <div class="network-center"><span class="center-ring"></span><span class="center-core"></span><span class="center-label">SURFACE<br />D’ANALYSE</span></div>
            <span class="node-label node-label-a">EDGE / 01</span>
            <span class="node-label node-label-b">NODE / 04</span>
            <span class="node-label node-label-c">GATEWAY</span>
            <span class="node-label node-label-d">TLS: ACTIVE</span>
            <span class="coordinate coordinate-a">48.8566° N<br />2.3522° E</span>
            <span class="coordinate coordinate-b">TRAFIC<br />CHIFFRÉ</span>
            <span class="art-cross cross-a">+</span><span class="art-cross cross-b">+</span>
          </div>
          <div class="art-footer"><span>RÉSEAU PRIVÉ</span><span>PROTOCOLE : VEILLE</span><span class="art-status">INTÉGRITÉ OK</span></div>
        </div>
        </div>
        <a class="scroll-cue" href="#profil"><span class="scroll-line"></span> DÉFILER POUR EXPLORER</a>
      </section>

      <section class="profile-section section-shell" id="profil" aria-labelledby="profile-title" data-scroll-section>
        <div class="profile-rail">
          <div class="section-heading profile-heading" data-parallax="0.14">
            <p class="section-kicker">LE PROFIL</p>
            <h2 id="profile-title">La curiosité<br />comme première <span>ligne de défense.</span></h2>
          </div>
          <section class="cyber-game" aria-labelledby="game-title">
            <header class="cyber-game-header"><span id="game-title">TRACE RUN / 01</span><span data-game-status>VEILLE</span></header>
            <canvas class="cyber-game-canvas" width="720" height="400" tabindex="0" aria-label="Mini-jeu Trace Run. Collectez les paquets verts et évitez les signaux ICE avec les flèches ou les touches ZQSD."></canvas>
            <div class="cyber-game-footer">
              <p><b data-game-score>00</b> PAQUETS CAPTURÉS <span>← → / Z Q S D</span></p>
              <button class="cyber-game-start" type="button" data-game-start>INITIALISER <span aria-hidden="true">↗</span></button>
            </div>
            <div class="cyber-game-controls" aria-label="Contrôles tactiles du jeu">
              <button type="button" data-game-direction="left" aria-label="Déplacer à gauche">←</button>
              <button type="button" data-game-direction="up" aria-label="Déplacer vers le haut">↑</button>
              <button type="button" data-game-direction="down" aria-label="Déplacer vers le bas">↓</button>
              <button type="button" data-game-direction="right" aria-label="Déplacer à droite">→</button>
            </div>
          </section>
        </div>
        <div class="profile-body" data-parallax="0.1">
          <p class="profile-lead">Mon intérêt pour l’informatique a commencé par l’infrastructure : les systèmes, les réseaux et tout ce qui permet aux services numériques de fonctionner.</p>
          <p>La cybersécurité s’est imposée comme une suite naturelle. Elle me permet de partir de cette base technique tout en explorant des sujets très différents : comprendre les failles, protéger les systèmes, analyser les risques et chercher des réponses concrètes. C’est cette polyvalence qui me plaît.</p>
          <p>Chez Ynov, je développe ces compétences à travers des projets en sécurité web, en OSINT et en administration Linux. À terme, je souhaite m’orienter vers un métier lié à la sécurité informatique, continuer à apprendre et contribuer à la protection des infrastructures et des données.</p>
          <p>La boxe et la course à pied m’ont aussi appris à avancer avec régularité : rester discipliné, garder mon calme dans l’effort et continuer même quand le résultat demande du temps. En cybersécurité, cette patience compte autant que la technique : observer, vérifier ses hypothèses et progresser étape par étape.</p>
          <p>Mes expériences comme équipier polyvalent et ouvrier agricole m’ont appris deux autres réflexes que je retrouve dans ce domaine : savoir prendre ma place dans une équipe et m’adapter au travail concret, avec sérieux et constance. Aujourd’hui, je veux réunir ces qualités et mon intérêt pour l’infrastructure dans un métier de la sécurité informatique.</p>
          <div class="language-row"><span>LANGUES</span>{profile.languages.map((language) => <span class="language-tag">{language}</span>)}</div>
        </div>
        <div class="profile-stamp" aria-hidden="true" data-parallax="0.22"><span>APPRENDRE<br />TESTER<br />RENFORCER</span><span class="stamp-mark">↗</span></div>
      </section>

      <section class="projects-section" id="projets" aria-labelledby="projects-title" data-scroll-section>
        <div class="section-shell">
          <div class="projects-header" data-parallax="0.12">
            <div class="section-heading">
              <p class="section-kicker">TRAVAUX SÉLECTIONNÉS</p>
              <h2 id="projects-title">Du concret,<br /><span>sur le terrain.</span></h2>
            </div>
            <div class="projects-header-aside">
              <p class="projects-count"><b>{String(projects.length).padStart(2, '0')}</b> ENTRÉES</p>
              <p class="projects-intro">Des projets personnels pour apprendre en construisant : applications, systèmes et analyse de sécurité.</p>
            </div>
          </div>
          <div class="project-list">
            {projects.map((project, index) => {
              const n = String(index + 1).padStart(2, '0');
              const total = String(projects.length).padStart(2, '0');
              return (
              <article class:list={['project-row', `tone-${project.tone}`]} style={`--reveal-delay: ${Math.min(index * 75, 375)}ms`} data-parallax-row>
                <div class="project-index" aria-hidden="true" data-parallax="0.08">{n}<span> / {total}</span></div>
                <div class:list={['project-visual', `visual-${project.visual}`]} data-parallax="0.16">
                  {project.cover && (
                    project.pdf
                      ? <a class="project-cover-link" href={project.pdf} target="_blank" rel="noreferrer" aria-label={`Ouvrir la présentation de ${project.name}`}>
                          <img class="project-cover" src={project.cover} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
                        </a>
                      : <img class="project-cover" src={project.cover} alt="" loading="lazy" />
                  )}
                  <div class="project-visual-meta" aria-hidden="true">
                    <span>PRJ / {n}</span>
                    <span class="project-visual-signal">SCAN</span>
                  </div>
                  <span class="project-frame" aria-hidden="true"></span>
                </div>
                <div class="project-content">
                  <p class="project-category">{project.category}</p>
                  <h3>{project.name}</h3>
                  <p class="project-description">{project.description}</p>
                  <ul class="project-tags">{project.details.map((detail) => <li>{detail}</li>)}</ul>
                </div>
                <div class="project-actions">
                  {project.github && <a class="project-action project-code" href={project.github} target="_blank" rel="noreferrer">Code source <span aria-hidden="true">↗</span></a>}
                  {project.pdf && <a class="project-action project-presentation" href={project.pdf} target="_blank" rel="noreferrer">Présentation <span aria-hidden="true">↗</span></a>}
                </div>
              </article>
              );
            })}
          </div>
          <p class="projects-note"><span>+</span> D’autres projets viendront enrichir cette sélection.</p>
        </div>
      </section>

      <section class="experience-section section-shell" id="parcours" aria-labelledby="experience-title" data-scroll-section>
        <div class="experience-heading" data-parallax="0.14">
          <p class="section-kicker">EXPÉRIENCE & FORMATION</p>
          <h2 id="experience-title">Mon parcours<span>.</span></h2>
          <p>{profile.school}</p>
        </div>
        <div class="experience-content">
          <div class="experience-main">
            <div class="timeline-group">
              <h3 class="timeline-heading">Expériences professionnelles</h3>
              <div class="timeline">
                {experience.map((item, index) => (
                  <article class="timeline-entry" style={`--reveal-delay: ${Math.min(index * 65, 260)}ms`}>
                    <div class="timeline-period">{item.period}</div>
                    <div class="timeline-copy"><h4>{item.role}</h4><p class="timeline-org">{item.organization}</p><p>{item.description}</p></div>
                    <span class="timeline-dot" aria-hidden="true"></span>
                  </article>
                ))}
              </div>
            </div>
            <div class="timeline-group education-group">
              <h3 class="timeline-heading">Études</h3>
              <div class="timeline">
                {education.map((item, index) => (
                  <article class="timeline-entry education-entry" style={`--reveal-delay: ${Math.min(index * 65, 260)}ms`}>
                    <div class="timeline-period">{item.period}</div>
                    <div class="timeline-copy education-copy"><div class="education-title-row"><div><h4>{item.qualification}</h4><p class="timeline-org">{item.institution}</p></div>{item.logo && <img class="education-logo" src={item.logo} alt={`Logo ${item.institution}`} loading="lazy" />}</div>{item.detail && <p>{item.detail}</p>}</div>
                    <span class="timeline-dot" aria-hidden="true"></span>
                  </article>
                ))}
              </div>
            </div>
          </div>
          <div class="skills-block">
            <h3>Boîte à outils</h3>
            {skillGroups.map((group) => (
              <div class="skill-group"><h4>{group.name}</h4><ul>{group.items.map((item) => <li>{item}</li>)}</ul></div>
            ))}
            <div class="training-block">
              <h4>Formation en cours</h4>
              <p>{currentTraining.name}<br /><span>{currentTraining.provider} · {currentTraining.period}</span></p>
            </div>
            <div class="certification-block">
              <h4>Certifications</h4>
              <div class="certification-gallery">
                {certifications.map((certification, index) => (
                  <article class="certificate-item" style={`--reveal-delay: ${Math.min(index * 80, 240)}ms`}>
                    <a class="certificate-preview" href={certification.image} target="_blank" rel="noreferrer" aria-label={`Agrandir le certificat ${certification.name}`}>
                      <img src={certification.image} alt={`Certificat ${certification.name}, délivré par ${certification.issuer}`} loading="lazy" />
                      <span class="certificate-zoom" aria-hidden="true">↗</span>
                    </a>
                    <div class="certificate-info">
                      <div><h5>{certification.name}</h5><p>{certification.issuer} · {certification.date}</p></div>
                      <a class="certificate-download" href={certification.image} download aria-label={`Télécharger le certificat ${certification.name}`} title="Télécharger le certificat">↓</a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title" data-scroll-section>
        <div class="contact-inner section-shell">
          <div class="contact-copy" data-parallax="0.1"><p class="section-kicker">OUVERT AUX ÉCHANGES</p><h2 id="contact-title">Un système à<br /><span>renforcer ?</span></h2><p>Pour parler cybersécurité, infrastructure, stage ou projet, ma boîte de réception est ouverte.</p></div>
          <div class="contact-actions" data-parallax="0.18">
            <p class="contact-channel">CANAL DIRECT <b>·</b> RÉPONSE SOUS 48H</p>
            <a class="contact-email" href={`mailto:${profile.email}`}><span>{profile.email}</span><i aria-hidden="true">↗</i></a>
            <div class="contact-links"><a href={`tel:${profile.phone}`}>Téléphone <span aria-hidden="true">↗</span></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href="/cv-tahiry-ramambazafy.pdf" target="_blank" rel="noreferrer">Curriculum vitæ <span aria-hidden="true">↗</span></a></div>
          </div>
          <div class="contact-grid" aria-hidden="true"></div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><a class="brand footer-brand" href="#accueil"><span class="brand-mark" aria-hidden="true"><span class="brand-letter">T</span><span class="brand-axis"></span><span class="brand-dot"></span></span><span class="brand-name">TAHIRY RAMAMBAZAFY</span></a><span>CYBERSÉCURITÉ · SYSTÈMES · RÉSEAUX</span><span>© {year} · FAIT AVEC CURIOSITÉ</span></footer>

    <script>
      const sectionLinks = [...document.querySelectorAll('[data-section-link]')];
      sectionLinks.forEach((link) => {
        link.addEventListener('click', () => {
          sectionLinks.forEach((item) => item.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'location');
        });
      });

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          sectionLinks.forEach((link) => {
            if (link.dataset.sectionLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      }, { rootMargin: '-24% 0px -64% 0px', threshold: 0 });

      sectionLinks.forEach((link) => {
        const section = document.getElementById(link.dataset.sectionLink);
        if (section) sectionObserver.observe(section);
      });

      const canvas = document.querySelector('.network-canvas');
      const context = canvas?.getContext('2d');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reducedMotion) {
        const root = document.documentElement;
        const hero = document.querySelector('.hero');
        const heroParallax = document.querySelector('[data-hero-parallax]');
        const header = document.querySelector('[data-site-header]');
        const contact = document.querySelector('.contact-section');
        const contactGrid = document.querySelector('.contact-grid');
        const readout = document.querySelector('[data-scroll-readout]');
        const gaugeTicks = [...document.querySelectorAll('[data-gauge]')];
        const parallaxNodes = [...document.querySelectorAll('[data-parallax]')];
        const scrollSections = [...document.querySelectorAll('[data-scroll-section]')];
        const projectRows = [...document.querySelectorAll('[data-parallax-row]')];
        const fallbackParallax = !CSS.supports('animation-timeline: view()');
        const projectCovers = [...document.querySelectorAll('.project-cover, .certificate-preview img')];
        let queued = false;
        let lastY = window.scrollY;
        let velocity = 0;

        const sectionProgress = (el) => {
          const rect = el.getBoundingClientRect();
          const total = window.innerHeight + rect.height;
          return Math.min(Math.max((window.innerHeight - rect.top) / total, 0), 1);
        };

        const updateMotion = () => {
          const y = window.scrollY;
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const pageProgress = scrollable > 0 ? y / scrollable : 0;
          velocity += ((y - lastY) - velocity) * 0.18;
          lastY = y;

          root.style.setProperty('--page-progress', pageProgress.toFixed(4));
          root.style.setProperty('--scroll-velocity', Math.max(-1.4, Math.min(1.4, velocity / 28)).toFixed(3));
          root.classList.toggle('is-scrolled', y > 28);

          if (readout) readout.textContent = `${String(Math.round(pageProgress * 100)).padStart(2, '0')}%`;

          if (hero) {
            const heroProgress = Math.min(Math.max(y / Math.max(hero.offsetHeight * 0.85, 1), 0), 1);
            root.style.setProperty('--hero-progress', heroProgress.toFixed(3));
          }

          if (header) header.dataset.compact = y > 48 ? 'true' : 'false';

          scrollSections.forEach((section) => {
            const progress = sectionProgress(section);
            section.style.setProperty('--inview', progress.toFixed(3));
            const mid = Math.abs(progress - 0.5);
            section.classList.toggle('is-active-section', mid < 0.28);
          });

          const activeId = scrollSections.find((section) => section.classList.contains('is-active-section'))?.id;
          gaugeTicks.forEach((tick) => {
            tick.classList.toggle('is-active', tick.dataset.gauge === activeId);
          });

          parallaxNodes.forEach((node) => {
            const speed = Number.parseFloat(node.dataset.parallax) || 0.12;
            const rect = node.getBoundingClientRect();
            const offset = (rect.top + rect.height * 0.5 - window.innerHeight * 0.5) / window.innerHeight;
            const shift = offset * speed * -90;
            const skew = velocity * speed * 0.35;
            node.style.setProperty('--parallax-y', `${shift.toFixed(2)}px`);
            node.style.setProperty('--parallax-skew', `${Math.max(-1.2, Math.min(1.2, skew)).toFixed(2)}deg`);
          });

          projectRows.forEach((row, index) => {
            const progress = sectionProgress(row);
            const depth = (progress - 0.5) * (14 + (index % 3) * 4);
            row.style.setProperty('--row-shift', `${depth.toFixed(2)}px`);
            row.style.setProperty('--row-scale', (0.985 + Math.max(0, 1 - Math.abs(progress - 0.52) * 1.6) * 0.015).toFixed(4));
            row.classList.toggle('is-near', Math.abs(progress - 0.5) < 0.22);
          });

          if (fallbackParallax) {
            projectCovers.forEach((cover) => {
              const rect = cover.getBoundingClientRect();
              const travel = Math.min(Math.max((window.innerHeight - rect.top) / (window.innerHeight + rect.height), 0), 1);
              cover.style.setProperty('--image-shift', `${((travel - 0.5) * 14).toFixed(2)}%`);
            });
          }
          queued = false;
        };

        const requestMotionUpdate = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(updateMotion);
          }
        };

        if (hero && heroParallax && window.matchMedia('(pointer: fine)').matches) {
          hero.addEventListener('pointermove', (event) => {
            const bounds = hero.getBoundingClientRect();
            const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
            const yPointer = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
            root.style.setProperty('--hero-pointer-x', x.toFixed(3));
            root.style.setProperty('--hero-pointer-y', yPointer.toFixed(3));
            root.style.setProperty('--hero-tilt-x', `${(yPointer * 5).toFixed(2)}deg`);
            root.style.setProperty('--hero-tilt-y', `${(x * -7).toFixed(2)}deg`);
          }, { passive: true });

          hero.addEventListener('pointerleave', () => {
            root.style.setProperty('--hero-pointer-x', '0');
            root.style.setProperty('--hero-pointer-y', '0');
            root.style.setProperty('--hero-tilt-x', '0deg');
            root.style.setProperty('--hero-tilt-y', '0deg');
          }, { passive: true });
        }

        if (contact && contactGrid && window.matchMedia('(pointer: fine)').matches) {
          contact.addEventListener('pointermove', (event) => {
            const bounds = contact.getBoundingClientRect();
            const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
            const yPointer = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
            root.style.setProperty('--contact-pointer-x', x.toFixed(3));
            root.style.setProperty('--contact-pointer-y', yPointer.toFixed(3));
          }, { passive: true });

          contact.addEventListener('pointerleave', () => {
            root.style.setProperty('--contact-pointer-x', '0');
            root.style.setProperty('--contact-pointer-y', '0');
          }, { passive: true });
        }

        updateMotion();
        window.addEventListener('scroll', requestMotionUpdate, { passive: true });
        window.addEventListener('resize', requestMotionUpdate, { passive: true });
      } else {
        const readout = document.querySelector('[data-scroll-readout]');
        if (readout) readout.textContent = '—';
      }

      if (canvas && context) {
        const points = [
          [0.18, 0.31, -0.42], [0.27, 0.19, 0.36], [0.42, 0.31, -0.12], [0.61, 0.16, 0.62], [0.76, 0.29, -0.24], [0.84, 0.43, 0.46],
          [0.17, 0.51, 0.18], [0.31, 0.45, -0.65], [0.48, 0.5, 0.48], [0.65, 0.43, -0.35], [0.79, 0.6, 0.16], [0.24, 0.7, -0.14],
          [0.37, 0.67, 0.7], [0.57, 0.76, -0.48], [0.71, 0.7, 0.3], [0.84, 0.83, -0.7],
        ];
        const links = [[0, 1], [1, 2], [2, 3], [3, 4], [4, 5], [0, 6], [2, 7], [2, 8], [3, 9], [5, 10], [6, 7], [7, 8], [8, 9], [9, 10], [6, 11], [7, 12], [8, 12], [8, 13], [9, 13], [10, 14], [10, 15], [11, 12], [12, 13], [13, 14], [14, 15]];
        let width = 0;
        let height = 0;
        let frame = 0;

        const draw = (time = 0) => {
          const bounds = canvas.getBoundingClientRect();
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          if (bounds.width !== width || bounds.height !== height) {
            width = bounds.width;
            height = bounds.height;
            canvas.width = width * ratio;
            canvas.height = height * ratio;
          }
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
          context.clearRect(0, 0, width, height);
          const styles = getComputedStyle(document.documentElement);
          const pointerX = reducedMotion ? 0 : Number.parseFloat(styles.getPropertyValue('--hero-pointer-x')) || 0;
          const pointerY = reducedMotion ? 0 : Number.parseFloat(styles.getPropertyValue('--hero-pointer-y')) || 0;
          const yaw = pointerX * 0.2;
          const pitch = pointerY * 0.14;
          const nodes = points.map(([x, y, z], index) => {
            const relativeX = x - 0.5;
            const relativeY = y - 0.5;
            const yawX = relativeX * Math.cos(yaw) + z * Math.sin(yaw);
            const yawZ = z * Math.cos(yaw) - relativeX * Math.sin(yaw);
            const tiltY = relativeY * Math.cos(pitch) - yawZ * Math.sin(pitch);
            const depth = yawZ * Math.cos(pitch) + relativeY * Math.sin(pitch);
            const perspective = 1 / (1 - depth * 0.3);
            const driftX = !reducedMotion ? Math.sin(time / 2500 + index * 0.8) * 2.4 * perspective : 0;
            const driftY = !reducedMotion ? Math.cos(time / 3000 + index * 0.65) * 2.4 * perspective : 0;
            return {
              x: width * (0.5 + yawX * perspective) + driftX,
              y: height * (0.5 + tiltY * perspective) + driftY,
              depth,
              perspective,
            };
          });

          links.forEach(([from, to], index) => {
            const start = nodes[from];
            const end = nodes[to];
            context.beginPath();
            context.moveTo(start.x, start.y);
            context.lineTo(end.x, end.y);
            const depth = (start.depth + end.depth) / 2;
            const alpha = Math.max(0.08, 0.18 + depth * 0.08);
            context.strokeStyle = index % 5 === 0 ? `rgba(200, 243, 82, ${alpha + 0.1})` : `rgba(214, 224, 207, ${alpha})`;
            context.lineWidth = Math.max(0.7, 0.85 + depth * 0.4);
            context.stroke();

            if (!reducedMotion) {
              const progress = (time / 2300 + index * 0.157) % 1;
              const x = start.x + (end.x - start.x) * progress;
              const y = start.y + (end.y - start.y) * progress;
              context.beginPath();
              context.arc(x, y, (index % 4 === 0 ? 2.1 : 1.2) * ((start.perspective + end.perspective) / 2), 0, Math.PI * 2);
              context.fillStyle = index % 4 === 0 ? '#c8f352' : '#8cded4';
              context.fill();
            }
          });

          [...nodes].sort((a, b) => a.depth - b.depth).forEach((node, index) => {
            const radius = (index % 4 === 0 ? 3.1 : 1.7) * node.perspective;
            if (index % 4 === 0) {
              context.beginPath();
              context.arc(node.x, node.y, radius * 2.8, 0, Math.PI * 2);
              context.fillStyle = 'rgba(200, 243, 82, .09)';
              context.fill();
            }
            context.beginPath();
            context.arc(node.x, node.y, radius, 0, Math.PI * 2);
            context.fillStyle = index % 4 === 0 ? '#c8f352' : 'rgba(220, 230, 214, .66)';
            context.fill();
          });
          if (!reducedMotion) frame = requestAnimationFrame(draw);
        };

        draw();
        if (reducedMotion) window.addEventListener('resize', () => draw(), { passive: true });
        else window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
      }

      const gameCanvas = document.querySelector('.cyber-game-canvas');
      const gameStart = document.querySelector('[data-game-start]');
      const gameScore = document.querySelector('[data-game-score]');
      const gameStatus = document.querySelector('[data-game-status]');

      if (gameCanvas && gameStart && gameScore && gameStatus) {
        const gameContext = gameCanvas.getContext('2d');
        const controls = new Set();
        const state = { active: false, score: 0, elapsed: 0, lastFrame: 0, player: { x: 0.5, y: 0.76 }, packets: [], ice: [], frame: 0, run: 0 };
        const randomPoint = () => ({ x: 0.12 + Math.random() * 0.76, y: 0.14 + Math.random() * 0.58 });
        const createIce = () => ({ x: 0.08 + Math.random() * 0.84, y: -0.08 - Math.random() * 0.35, drift: (Math.random() - 0.5) * 0.18, speed: 0.12 + Math.random() * 0.12 });

        const resetGame = () => {
          state.active = true;
          state.run += 1;
          const run = state.run;
          state.score = 0;
          state.elapsed = 0;
          state.lastFrame = performance.now();
          state.player = { x: 0.5, y: 0.76 };
          state.packets = Array.from({ length: 4 }, randomPoint);
          state.ice = Array.from({ length: 3 }, createIce);
          gameScore.textContent = '00';
          gameStatus.textContent = 'LIAISON ACTIVE';
          gameStart.innerHTML = 'REINITIALISER <span aria-hidden="true">↗</span>';
          gameCanvas.focus({ preventScroll: true });
          requestAnimationFrame((time) => loop(time, run));
        };

        const resizeGame = () => {
          const bounds = gameCanvas.getBoundingClientRect();
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const targetWidth = Math.max(1, Math.round(bounds.width * ratio));
          const targetHeight = Math.max(1, Math.round(bounds.height * ratio));
          if (gameCanvas.width !== targetWidth || gameCanvas.height !== targetHeight) {
            gameCanvas.width = targetWidth;
            gameCanvas.height = targetHeight;
          }
          gameContext.setTransform(ratio, 0, 0, ratio, 0, 0);
          return { width: bounds.width, height: bounds.height };
        };

        const drawGame = () => {
          const { width, height } = resizeGame();
          gameContext.clearRect(0, 0, width, height);
          gameContext.fillStyle = '#101610';
          gameContext.fillRect(0, 0, width, height);
          gameContext.strokeStyle = 'rgba(200, 243, 82, .08)';
          gameContext.lineWidth = 1;
          for (let x = 0; x < width; x += 30) { gameContext.beginPath(); gameContext.moveTo(x, 0); gameContext.lineTo(x, height); gameContext.stroke(); }
          for (let y = 0; y < height; y += 30) { gameContext.beginPath(); gameContext.moveTo(0, y); gameContext.lineTo(width, y); gameContext.stroke(); }

          const toCanvas = (point) => ({ x: point.x * width, y: point.y * height });
          state.packets.forEach((packet, index) => {
            const point = toCanvas(packet);
            const pulse = 4 + Math.sin(state.frame / 260 + index) * 1.5;
            gameContext.beginPath(); gameContext.arc(point.x, point.y, pulse * 2.2, 0, Math.PI * 2); gameContext.fillStyle = 'rgba(200, 243, 82, .08)'; gameContext.fill();
            gameContext.fillStyle = '#c8f352'; gameContext.fillRect(point.x - 3, point.y - 3, 6, 6);
          });

          state.ice.forEach((ice) => {
            const point = toCanvas(ice);
            gameContext.beginPath(); gameContext.moveTo(point.x, point.y - 8); gameContext.lineTo(point.x + 8, point.y + 7); gameContext.lineTo(point.x - 8, point.y + 7); gameContext.closePath();
            gameContext.fillStyle = 'rgba(255, 112, 86, .85)'; gameContext.fill();
          });

          const player = toCanvas(state.player);
          gameContext.save(); gameContext.translate(player.x, player.y); gameContext.rotate(Math.sin(state.frame / 420) * 0.08);
          gameContext.fillStyle = '#c8f352'; gameContext.fillRect(-8, -8, 16, 16);
          gameContext.fillStyle = '#101610'; gameContext.fillRect(-3, -3, 6, 6);
          gameContext.restore();
          gameContext.fillStyle = 'rgba(200, 243, 82, .65)'; gameContext.font = '10px "Space Mono", monospace'; gameContext.fillText(state.active ? `${Math.max(0, 30 - Math.ceil(state.elapsed)).toString().padStart(2, '0')} SEC` : 'PRÊT À LANCER', 12, height - 14);
        };

        const loop = (time, run) => {
          if (!state.active || run !== state.run) return;
          const delta = Math.min((time - state.lastFrame) / 1000, 0.05);
          state.lastFrame = time;
          state.frame = time;
          state.elapsed += delta;
          const horizontal = (controls.has('ArrowRight') || controls.has('d')) - (controls.has('ArrowLeft') || controls.has('a') || controls.has('q'));
          const vertical = (controls.has('ArrowDown') || controls.has('s')) - (controls.has('ArrowUp') || controls.has('z') || controls.has('w'));
          state.player.x = Math.min(0.94, Math.max(0.06, state.player.x + horizontal * delta * 0.54));
          state.player.y = Math.min(0.9, Math.max(0.1, state.player.y + vertical * delta * 0.54));
          state.ice.forEach((ice) => { ice.y += ice.speed * delta; ice.x += ice.drift * delta; if (ice.y > 1.08 || ice.x < 0 || ice.x > 1) Object.assign(ice, createIce()); });
          state.packets.forEach((packet, index) => {
            if (Math.hypot(packet.x - state.player.x, packet.y - state.player.y) < 0.055) { state.score += 1; state.packets[index] = randomPoint(); gameScore.textContent = String(state.score).padStart(2, '0'); }
          });
          if (state.ice.some((ice) => Math.hypot(ice.x - state.player.x, ice.y - state.player.y) < 0.055) || state.elapsed >= 30) {
            state.active = false;
            gameStatus.textContent = `TRACE TERMINÉE · ${state.score} PKT`;
            gameStart.innerHTML = 'REJOUER <span aria-hidden="true">↗</span>';
          }
          drawGame();
          if (state.active) requestAnimationFrame((nextTime) => loop(nextTime, run));
        };

        const movementKeys = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'q', 's', 'w', 'z']);
        window.addEventListener('keydown', (event) => { const key = event.key.toLowerCase(); if (state.active && movementKeys.has(event.key) || state.active && movementKeys.has(key)) { event.preventDefault(); controls.add(key); controls.add(event.key); } });
        window.addEventListener('keyup', (event) => { controls.delete(event.key); controls.delete(event.key.toLowerCase()); });
        gameStart.addEventListener('click', resetGame);
        gameCanvas.addEventListener('click', () => { if (!state.active) resetGame(); });
        document.querySelectorAll('[data-game-direction]').forEach((button) => {
          const direction = { left: 'ArrowLeft', right: 'ArrowRight', up: 'ArrowUp', down: 'ArrowDown' }[button.dataset.gameDirection];
          button.addEventListener('pointerdown', (event) => { event.preventDefault(); if (!state.active) resetGame(); controls.add(direction); });
          ['pointerup', 'pointerleave', 'pointercancel'].forEach((type) => button.addEventListener(type, () => controls.delete(direction)));
        });
        drawGame();
      }

    </script>
  </body>
</html>
