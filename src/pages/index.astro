---
import '../styles/global.css';
import * as simpleIcons from 'simple-icons';
import { certifications, currentTraining, education, experience, profile, projectKinds, projects, stack } from '../data/portfolio.js';

const now = new Date();
const year = now.getFullYear();
const currentMonth = `${year}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const statusOf = ({ start, end }) => {
  if (!start) return null;
  if (start > currentMonth) return { key: 'upcoming', label: 'À venir' };
  if (end && end < currentMonth) return { key: 'done', label: 'Terminé' };
  return { key: 'current', label: 'En cours' };
};

// Stack logos: brand marks from Simple Icons (filled), otherwise a stroked pictogram drawn on the same 24px grid.
const pictograms = {
  gamepad: '<rect x="2.5" y="7" width="19" height="10" rx="5"/><path d="M7 10v4M5 12h4"/><circle cx="15.5" cy="11" r=".9"/><circle cx="18" cy="13.4" r=".9"/>',
  layers: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/>',
  debug: '<rect x="7" y="7" width="10" height="13" rx="5"/><path d="M12 11v9M7 12H3M21 12h-4M7 17H4M20 17h-3M8.5 7.5 6 5M15.5 7.5 18 5"/>',
  windows: '<path d="M3 3h8.4v8.4H3zM12.6 3H21v8.4h-8.4zM3 12.6h8.4V21H3zM12.6 12.6H21V21h-8.4z" fill="currentColor" stroke="none"/>',
  backup: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6M4 11.5v6c0 1.6 3.2 2.9 7.3 3"/><path d="m15.5 18.5 2 2 4-4"/>',
  shield: '<path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 1.5v5M12 17.5v5M1.5 12h5M17.5 12h5"/>',
  audit: '<rect x="5" y="4" width="14" height="17" rx="1.5"/><path d="M9 4V2.5h6V4"/><path d="m9 13 2 2 4-4"/>',
  firewall: '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9.3h18M3 14.7h18M9 4v5.3M15 4v5.3M6 9.3v5.4M12 9.3v5.4M18 9.3v5.4M9 14.7V20M15 14.7V20"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="1.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5M12 14.5v2.5"/>',
  risk: '<path d="M12 3.5 2.5 20h19L12 3.5Z"/><path d="M12 10v4.5M12 17.3v.2"/>',
  vm: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4M7 8h5M7 11.5h8"/>',
  key: '<circle cx="8" cy="15.5" r="4.5"/><path d="m11.2 12.3 8.8-8.8M16.5 7l2.5 2.5M14.5 9l1.8 1.8"/>',
  badge: '<circle cx="12" cy="9" r="6"/><path d="M8.6 14 7 21l5-2.5 5 2.5-1.6-7"/><path d="m9.7 9 1.6 1.6 3-3"/>',
};
// Brand colours too dark to read on the panel (e.g. GitHub black) fall back to the ink token on hover.
const readableHex = (hex) => {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b >= 0.11 ? `#${hex}` : 'var(--ink)';
};
const stackIcon = (slug) => {
  const brand = simpleIcons[`si${slug[0].toUpperCase()}${slug.slice(1)}`];
  if (brand) return { slug, kind: 'brand', title: brand.title, path: brand.path, color: readableHex(brand.hex) };
  if (!pictograms[slug]) throw new Error(`Unknown stack icon: ${slug}`);
  return { slug, kind: 'picto', markup: pictograms[slug] };
};
const githubPath = simpleIcons.siGithub.path;
const sections = [
  { id: 'profil', label: 'Profil' },
  { id: 'projets', label: 'Projets' },
  { id: 'competences', label: 'Compétences' },
  { id: 'parcours', label: 'Parcours' },
  { id: 'contact', label: 'Contact' },
];
// Stack "used in" labels → where they point: a project panel, or the Parcours section for internships / training.
const projectByUse = Object.fromEntries(projects.map((project) => [project.useLabel, project.id]));
const parcoursUses = new Set(['Stage Étoile', 'Formation Ynov', 'Préparation CCNA', 'SecNumacadémie']);
const useParts = (use) => use.split(' · ').map((label) => ({ label, project: projectByUse[label], parcours: parcoursUses.has(label) }));
const kindFilters = Object.entries(projectKinds)
  .map(([kind, label]) => ({ kind, label, count: projects.filter((project) => project.kind === kind).length }))
  .filter((filter) => filter.count > 0);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111927" />
    <meta name="description" content="Portfolio de Tahiry Ramambazafy, étudiant en cybersécurité à Ynov Toulouse, à la recherche d'une alternance. Projets en sécurité web, OSINT et infrastructure Linux." />
    <title>{profile.name} — Cybersécurité & infrastructures</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.name} — Cybersécurité & infrastructures`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/" />
    <meta property="og:title" content="Tahiry Ramambazafy — Cybersécurité & infrastructures" />
    <meta property="og:description" content="Étudiant en cybersécurité à Ynov, à la recherche d'une alternance : sécurité web, OSINT, Linux, Ansible." />
    <meta property="og:image" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tahiry Ramambazafy — Étudiant en cybersécurité, à la recherche d'une alternance." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tahiry Ramambazafy — Cybersécurité & infrastructures" />
    <meta name="twitter:description" content="Étudiant en cybersécurité à Ynov, à la recherche d'une alternance : sécurité web, OSINT, Linux, Ansible." />
    <meta name="twitter:image" content="https://tahiryramambazafy.tahiry-ramambazafy.workers.dev/og-image.jpg" />
    <meta name="twitter:image:alt" content="Tahiry Ramambazafy — Étudiant en cybersécurité, à la recherche d'une alternance." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <a class="brand" href="#accueil" aria-label="Accueil, Tahiry Ramambazafy">
        <span class="brand-mark" aria-hidden="true">T</span>
        <span class="brand-name">Tahiry Ramambazafy</span>
      </a>
      <nav class="main-nav" aria-label="Navigation principale">
        {sections.map((section) => <a href={`#${section.id}`} data-section-link={section.id}>{section.label}</a>)}
        <span class="nav-indicator" aria-hidden="true"></span>
      </nav>
      <div class="header-actions">
        <button class="palette-hint" type="button" data-palette-open aria-keyshortcuts="Control+K" aria-label="Rechercher (Ctrl K)"><span>Rechercher</span><kbd>Ctrl K</kbd></button>
        <a class="icon-link" href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={githubPath} /></svg>
        </a>
        <a class="button button-secondary button-small" href="/cv-tahiry-ramambazafy.pdf" target="_blank" rel="noreferrer">CV <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <nav class="bottom-nav" aria-label="Navigation mobile">
      {sections.map((section) => <a href={`#${section.id}`} data-section-link={section.id}>{section.label}</a>)}
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <main id="contenu">
      <div class="intro-zone" data-spotlight>
      <section class="hero section-shell" id="accueil" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Recherche une alternance en cybersécurité · {profile.location}</p>
          <h1 id="hero-title">{profile.name}</h1>
          <p class="hero-role">{profile.role} · {profile.focus}</p>
          <p class="hero-summary">{profile.summary}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projets">Voir les projets</a>
            <a class="button button-secondary" href="/cv-tahiry-ramambazafy.pdf" target="_blank" rel="noreferrer">Télécharger le CV <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <aside class="id-card" aria-labelledby="id-card-title">
          <header class="card-bar">
            <p id="id-card-title" class="card-bar-title"><span aria-hidden="true">$</span> whoami<i class="caret" aria-hidden="true"></i></p>
          </header>
          <dl class="id-list">
            <div style="--i: 0"><dt>Formation</dt><dd>Bachelor Cybersécurité · Ynov</dd></div>
            <div style="--i: 1"><dt>Titre visé</dt><dd>Administrateur systèmes, réseaux et bases de données · <a class="inline-link" href={profile.rncp.url} target="_blank" rel="noreferrer">{profile.rncp.code} <span aria-hidden="true">↗</span></a></dd></div>
            <div style="--i: 2"><dt>En cours</dt><dd>{currentTraining.name}</dd></div>
            <div style="--i: 3"><dt>Domaines</dt><dd>Sécurité web · OSINT · Linux · Réseaux</dd></div>
            <div style="--i: 4"><dt>Recherche</dt><dd>{profile.seeking}</dd></div>
            <div style="--i: 5"><dt>Localisation</dt><dd>{profile.location}</dd></div>
          </dl>
          <footer class="id-links">
            <a href={profile.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${profile.email}`}>E-mail <span aria-hidden="true">↗</span></a>
          </footer>
        </aside>
      </section>

      <section class="section section-shell profile-section" id="profil" aria-labelledby="profile-title">
        <div class="section-head" data-reveal>
          <h2 id="profile-title">Profil</h2>
          <p class="section-intro">{profile.lead}</p>
        </div>
        <div class="profile-grid">
          <ul class="about-grid">
            {profile.about.map((entry) => (
              <li class="card about-card" data-reveal>
                <h3 class="label">{entry.label}</h3>
                <p>{entry.text}</p>
              </li>
            ))}
          </ul>
          <div class="profile-side" data-reveal>
            <div>
              <h3 class="label">Compétences clés</h3>
              <ul class="tag-list">{profile.strengths.map((item) => <li class="tag">{item}</li>)}</ul>
            </div>
            <div>
              <h3 class="label">Langues</h3>
              <ul class="lang-list">
                {profile.languages.map((language) => (
                  <li><span>{language.name}</span><span class="lang-level">{language.label}</span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
      </div>

      <section class="section projects-section" id="projets" aria-labelledby="projects-title">
        <div class="section-shell">
          <div class="section-head" data-reveal>
            <h2 id="projects-title">Projets <span class="count">{projects.length}</span></h2>
            <p class="section-intro">Projets d’école et personnels : applications, systèmes et analyse de sécurité. Chacun est documenté par un rapport ou son code source.</p>
          </div>
          <div class="filter-bar" role="group" aria-label="Filtrer les projets par catégorie" data-reveal>
            <button class="filter" type="button" data-filter="all" aria-pressed="true">Tous <span>{projects.length}</span></button>
            {kindFilters.map((filter) => <button class="filter" type="button" data-filter={filter.kind} aria-pressed="false">{filter.label} <span>{filter.count}</span></button>)}
          </div>
          <p class="visually-hidden" aria-live="polite" data-filter-status></p>
          <div class="project-grid">
            {projects.map((project, index) => (
              <article class="card project-card" id={`carte-${project.id}`} data-kind={project.kind} data-reveal style={`--i: ${index % 2}; view-transition-name: projet-${project.id}`}>
                {project.cover && (
                  <div class="project-cover" aria-hidden="true">
                    <img src={project.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="project-body">
                  <p class="project-meta">
                    <span class:list={['pill', `kind-${project.kind}`]}>{projectKinds[project.kind]}</span>
                    <span class="project-category">{project.category}</span>
                  </p>
                  <h3><button class="project-open" type="button" data-project-open={project.id} aria-haspopup="dialog">{project.name}</button></h3>
                  <p class="project-description">{project.description}</p>
                  <dl class="project-spec">
                    <div><dt>Rôle</dt><dd>{project.role}</dd></div>
                    <div><dt>Résultat</dt><dd>{project.result}</dd></div>
                  </dl>
                  <ul class="tag-list">{project.details.map((detail) => <li class="tag">{detail}</li>)}</ul>
                  <div class="project-actions">
                    {project.pdf && <a class="button button-secondary button-small" href={project.pdf} target="_blank" rel="noreferrer">Rapport PDF <span aria-hidden="true">↗</span></a>}
                    {project.github && <a class="button button-secondary button-small" href={project.github} target="_blank" rel="noreferrer">Code source <span aria-hidden="true">↗</span></a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
          {projects.map((project) => (
            <template data-project-template={project.id}>
              {project.cover && <img class="panel-cover" src={project.cover} alt="" width="1200" height="675" />}
              <div class="panel-body">
                <p class="project-meta">
                  <span class="pill">{projectKinds[project.kind]}</span>
                  <span class="project-category">{project.category}</span>
                </p>
                <h2 class="panel-title" id="panel-title">{project.name}</h2>
                <p class="project-description">{project.description}</p>
                <dl class="project-spec">
                  <div><dt>Rôle</dt><dd>{project.role}</dd></div>
                  <div><dt>Résultat</dt><dd>{project.result}</dd></div>
                </dl>
                <ul class="tag-list">{project.details.map((detail) => <li class="tag">{detail}</li>)}</ul>
                <div class="project-actions">
                  {project.pdf && <a class="button button-primary button-small" href={project.pdf} target="_blank" rel="noreferrer">Ouvrir le rapport <span aria-hidden="true">↗</span></a>}
                  {project.github && <a class="button button-secondary button-small" href={project.github} target="_blank" rel="noreferrer">Code source <span aria-hidden="true">↗</span></a>}
                </div>
                {project.pdf && (
                  <div class="panel-pdf">
                    <p class="label">Aperçu du rapport</p>
                    <iframe src={`${project.pdf}#view=FitH&toolbar=0`} title={`Rapport PDF : ${project.name}`} loading="lazy"></iframe>
                  </div>
                )}
              </div>
            </template>
          ))}
        </div>
      </section>

      <section class="section section-shell" id="competences" aria-labelledby="stack-title">
        <div class="section-head" data-reveal>
          <h2 id="stack-title">Compétences</h2>
          <p class="section-intro">Chaque outil renvoie à l’endroit où je l’ai réellement utilisé : un projet, un stage ou une formation.</p>
        </div>
        <div class="stack-grid">
          {stack.map((domain) => (
            <article class="card stack-panel" aria-labelledby={`stack-${domain.id}`} data-reveal>
              <header class="card-bar">
                <h3 id={`stack-${domain.id}`} class="card-bar-title">{domain.name}</h3>
                <span class="label">{domain.items.length} outils</span>
              </header>
              <p class="stack-summary">{domain.summary}</p>
              <ul class="stack-list">
                {domain.items.map((item) => (
                  <li data-uses={useParts(item.use).map((part) => part.project).filter(Boolean).join(' ')}>
                    <span class="stack-icons" aria-hidden="true">
                      {item.icons.map(stackIcon).map((icon) => (
                        <svg class:list={['stack-icon', `is-${icon.kind}`]} viewBox="0 0 24 24" style={icon.color && `--brand: ${icon.color}`}>
                          {icon.kind === 'brand' ? <path d={icon.path} /> : <Fragment set:html={icon.markup} />}
                        </svg>
                      ))}
                    </span>
                    <span class="stack-name">{item.name}</span>
                    <span class="stack-use"><span class="visually-hidden">utilisé dans </span>{useParts(item.use).map((part, i) => (
                      <Fragment>
                        {i > 0 && ' · '}
                        {part.project
                          ? <button class="use-link" type="button" data-project-open={part.project} data-use={part.project}>{part.label}</button>
                          : part.parcours ? <a class="use-link" href="#parcours">{part.label}</a> : part.label}
                      </Fragment>
                    ))}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section parcours-section" id="parcours" aria-labelledby="experience-title">
        <div class="section-shell">
          <div class="section-head" data-reveal>
            <h2 id="experience-title">Parcours</h2>
            <p class="section-intro section-intro-line">Ynov · Administrateur systèmes, réseaux et bases de données · <a class="inline-link" href={profile.rncp.url} target="_blank" rel="noreferrer">{profile.rncp.code} <span aria-hidden="true">↗</span></a></p>
          </div>
          <div class="parcours-grid">
            <div class="timeline-group">
              <h3 class="group-title">Expérience</h3>
              <ol class="timeline">
                {experience.map((item) => {
                  const status = statusOf(item);
                  return (
                    <li class="timeline-entry" data-reveal>
                      <p class="timeline-period">{item.period}</p>
                      <div>
                        {(item.type || status) && <p class="timeline-badges">{item.type && <span class="pill">{item.type}</span>}{status && <span class:list={['pill', `is-${status.key}`]}>{status.label}</span>}</p>}
                        <h4>{item.role}</h4>
                        <p class="timeline-org">{item.organization}</p>
                        <p>{item.description}</p>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </div>
            <div class="timeline-group">
              <h3 class="group-title">Formation</h3>
              <ol class="timeline">
                {education.map((item) => (
                  <li class="timeline-entry" data-reveal>
                    <p class="timeline-period">{item.period}</p>
                    <div class="education-row">
                      <div>
                        <h4>{item.qualification}</h4>
                        <p class="timeline-org">{item.institution}</p>
                        {item.detail && <p>{item.detail}</p>}
                      </div>
                      {item.logo && <img class="education-logo" src={item.logo} alt={`Logo ${item.institution}`} width={item.logoSize?.[0]} height={item.logoSize?.[1]} loading="lazy" decoding="async" />}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <div class="timeline-group">
              <h3 class="group-title">Certifications</h3>
              <ul class="cert-list">
                <li class="card cert-item cert-current" data-reveal>
                  <div>
                    <h4>{currentTraining.name}</h4>
                    <p>{currentTraining.provider} · {currentTraining.period}</p>
                  </div>
                  <span class="pill is-current">En cours</span>
                </li>
                {certifications.map((certification) => (
                  <li class="card cert-item" data-reveal>
                    <img src={certification.thumb ?? certification.image} alt="" width={certification.thumbSize?.[0]} height={certification.thumbSize?.[1]} loading="lazy" decoding="async" />
                    <div>
                      <h4>{certification.name}</h4>
                      <p>{certification.issuer} · {certification.date}</p>
                    </div>
                    <a class="cert-link" href={certification.image} target="_blank" rel="noreferrer" aria-label={`Voir le certificat ${certification.name}`}>Voir <span aria-hidden="true">↗</span></a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-shell" id="contact" aria-labelledby="contact-title">
        <div class="card contact-card" data-reveal>
          <div class="contact-copy">
            <h2 id="contact-title">Contact</h2>
            <p>Je recherche une alternance en cybersécurité. Pour en parler, ou pour un projet ou une question technique, écrivez-moi : je réponds sous 48 h.</p>
          </div>
          <div class="contact-actions">
            <div class="contact-email-row">
              <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
              <button class="button button-secondary button-small copy-button" type="button" data-copy={profile.email}>Copier</button>
              <span class="visually-hidden" aria-live="polite" data-copy-status></span>
            </div>
            <div class="contact-links">
              <a class="button button-primary" href={`mailto:${profile.email}`}>Envoyer un e-mail</a>
              <a class="button button-secondary" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
              <a class="button button-secondary" href={profile.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <span>© {year} {profile.name}</span>
      <span>Cybersécurité · Systèmes · Réseaux</span>
      <button class="easter-egg" type="button" data-game-open>./trace-run</button>
    </footer>

    <a class="back-to-top" href="#accueil" aria-label="Retour en haut" data-back-to-top>↑</a>

    <dialog class="project-panel" aria-labelledby="panel-title">
      <div class="panel-bar">
        <span class="label">Projet</span>
        <button class="game-close" type="button" data-panel-close aria-label="Fermer le projet">✕</button>
      </div>
      <div class="panel-content" data-panel-content></div>
    </dialog>

    <dialog class="palette" aria-label="Recherche rapide">
      <div class="palette-input">
        <span aria-hidden="true">&gt;</span>
        <input type="text" placeholder="Aller à… (projets, cv, osint, contact)" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" data-palette-input />
        <kbd>Échap</kbd>
      </div>
      <ul class="palette-list" id="palette-list" role="listbox" aria-label="Résultats" data-palette-list>
        {sections.map((section) => <li role="option" data-action="goto" data-target={`#${section.id}`} data-group="Section">{section.label}</li>)}
        {projects.map((project) => <li role="option" data-action="project" data-target={project.id} data-group="Projet" data-keywords={`${projectKinds[project.kind]} ${project.category} ${project.details.join(' ')}`}>{project.name}</li>)}
        <li role="option" data-action="link" data-target="/cv-tahiry-ramambazafy.pdf" data-group="Lien" data-keywords="curriculum resume">CV (PDF)</li>
        <li role="option" data-action="link" data-target={profile.github} data-group="Lien">GitHub</li>
        <li role="option" data-action="link" data-target={profile.linkedin} data-group="Lien">LinkedIn</li>
        <li role="option" data-action="copy" data-target={profile.email} data-group="Action" data-keywords="mail email contact">Copier l’adresse e-mail</li>
        <li role="option" data-action="game" data-group="Action" data-keywords="jeu trace run easter egg">./trace-run</li>
      </ul>
      <p class="palette-empty" hidden data-palette-empty>Aucun résultat.</p>
    </dialog>

    <dialog class="game-dialog" aria-labelledby="game-title">
      <section class="cyber-game">
        <header class="card-bar">
          <h2 id="game-title" class="card-bar-title">Trace Run</h2>
          <span class="label" data-game-status>Prêt</span>
          <button class="game-close" type="button" data-game-close aria-label="Fermer le jeu">✕</button>
        </header>
        <canvas class="cyber-game-canvas" width="720" height="400" tabindex="0" aria-label="Mini-jeu Trace Run. Collectez les paquets verts et évitez les signaux rouges avec les flèches ou les touches ZQSD."></canvas>
        <footer class="cyber-game-footer">
          <p><b data-game-score>00</b> paquets capturés <span>← → / Z Q S D</span></p>
          <button class="button button-primary button-small" type="button" data-game-start>Lancer</button>
        </footer>
        <div class="cyber-game-controls" aria-label="Contrôles tactiles du jeu">
          <button type="button" data-game-direction="left" aria-label="Déplacer à gauche">←</button>
          <button type="button" data-game-direction="up" aria-label="Déplacer vers le haut">↑</button>
          <button type="button" data-game-direction="down" aria-label="Déplacer vers le bas">↓</button>
          <button type="button" data-game-direction="right" aria-label="Déplacer à droite">→</button>
        </div>
      </section>
    </dialog>

    <script>
      const sectionLinks = [...document.querySelectorAll('[data-section-link]')];

      // One sliding underline per nav, parked under the link marked aria-current.
      const moveIndicators = () => {
        document.querySelectorAll('.nav-indicator').forEach((indicator) => {
          const active = indicator.parentElement.querySelector('[aria-current="location"]');
          indicator.classList.toggle('is-visible', Boolean(active));
          if (!active) return;
          indicator.style.width = `${active.offsetWidth}px`;
          indicator.style.transform = `translateX(${active.offsetLeft}px)`;
        });
      };
      window.addEventListener('resize', moveIndicators, { passive: true });

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          sectionLinks.forEach((link) => {
            if (link.dataset.sectionLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
          moveIndicators();
        });
      }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });
      new Set(sectionLinks.map((link) => link.dataset.sectionLink)).forEach((id) => {
        const section = document.getElementById(id);
        if (section) sectionObserver.observe(section);
      });

      // Reveal: a single fade + short rise, once. Without JS or with reduced motion, content is simply visible.
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducedMotion) {
        document.documentElement.classList.add('reveal-ready');
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        document.querySelectorAll('[data-reveal]').forEach((node) => revealObserver.observe(node));
      }

      // Back to top: shown once the hero has left the viewport.
      const hero = document.querySelector('.hero');
      const backToTop = document.querySelector('[data-back-to-top]');
      if (hero && backToTop) {
        new IntersectionObserver(([entry]) => backToTop.classList.toggle('is-visible', !entry.isIntersecting), { rootMargin: '0px 0px -50% 0px' }).observe(hero);
      }

      // Spotlight over the hero + Profil zone (fine pointers only): one CSS variable pair, updated at most once per frame.
      const spotlightZone = document.querySelector('[data-spotlight]');
      if (spotlightZone && !reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let pending = null;
        spotlightZone.addEventListener('pointermove', (event) => {
          if (pending) return;
          pending = requestAnimationFrame(() => {
            // The zone spans the full viewport width, so x is the viewport x.
            const bounds = spotlightZone.getBoundingClientRect();
            spotlightZone.style.setProperty('--mx', `${event.clientX}px`);
            spotlightZone.style.setProperty('--my', `${event.clientY - bounds.top}px`);
            pending = null;
          });
        }, { passive: true });
      }

      // Project filter: toggles [hidden] on cards, animated by the View Transitions API when available.
      const filterButtons = [...document.querySelectorAll('[data-filter]')];
      const projectCards = [...document.querySelectorAll('.project-card')];
      const filterStatus = document.querySelector('[data-filter-status]');
      const applyFilter = (kind) => {
        let shown = 0;
        projectCards.forEach((card) => {
          const visible = kind === 'all' || card.dataset.kind === kind;
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === kind)));
        if (filterStatus) filterStatus.textContent = `${shown} projet${shown > 1 ? 's' : ''} affiché${shown > 1 ? 's' : ''}`;
      };
      let filterTransition = null;
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const run = () => applyFilter(button.dataset.filter);
          filterTransition?.skipTransition();
          if (document.startViewTransition && !reducedMotion) filterTransition = document.startViewTransition(run);
          else run();
        });
      });

      // Project panel: content cloned from a server-rendered <template>; the URL hash makes a project shareable.
      const panel = document.querySelector('.project-panel');
      const panelContent = document.querySelector('[data-panel-content]');
      let panelOpener = null;
      const openProject = (id, opener) => {
        const template = document.querySelector(`[data-project-template="${id}"]`);
        if (!panel || !panelContent || !template) return;
        filterTransition?.skipTransition();
        panelContent.replaceChildren(template.content.cloneNode(true));
        panelOpener = opener ?? document.querySelector(`[data-project-open="${id}"]`);
        if (!panel.open) panel.showModal();
        panel.scrollTop = 0;
        history.replaceState(null, '', `#projet-${id}`);
      };
      panel?.addEventListener('close', () => {
        panelContent?.replaceChildren();
        history.replaceState(null, '', `${location.pathname}${location.search}`);
        panelOpener?.focus({ preventScroll: true });
      });
      panel?.addEventListener('click', (event) => { if (event.target === panel) panel.close(); });
      document.querySelector('[data-panel-close]')?.addEventListener('click', () => panel?.close());
      document.querySelectorAll('[data-project-open]').forEach((trigger) => {
        trigger.addEventListener('click', () => openProject(trigger.dataset.projectOpen, trigger));
      });
      if (location.hash.startsWith('#projet-')) openProject(location.hash.slice('#projet-'.length));

      // Stack ↔ projects: hovering a "used in" link highlights every tool used on that same project.
      const stackItems = [...document.querySelectorAll('.stack-list li[data-uses]')];
      document.querySelectorAll('.use-link[data-use]').forEach((link) => {
        const toggle = (on) => stackItems.forEach((item) => item.classList.toggle('is-linked', on && item.dataset.uses.split(' ').includes(link.dataset.use)));
        link.addEventListener('pointerenter', () => toggle(true));
        link.addEventListener('pointerleave', () => toggle(false));
        link.addEventListener('focus', () => toggle(true));
        link.addEventListener('blur', () => toggle(false));
      });

      // Copy e-mail, with a polite live-region announcement.
      const copyText = async (text) => {
        try { await navigator.clipboard.writeText(text); return true; } catch { return false; }
      };
      const copyButton = document.querySelector('[data-copy]');
      const copyStatus = document.querySelector('[data-copy-status]');
      copyButton?.addEventListener('click', async () => {
        const ok = await copyText(copyButton.dataset.copy);
        copyButton.textContent = ok ? 'Copié ✓' : 'Échec';
        if (copyStatus) copyStatus.textContent = ok ? 'Adresse e-mail copiée' : 'Copie impossible';
        setTimeout(() => { copyButton.textContent = 'Copier'; }, 2000);
      });

      // Command palette (Ctrl/⌘ + K or "/"): filters the options, ↑ ↓ to move, Entrée to run.
      const palette = document.querySelector('.palette');
      const paletteInput = document.querySelector('[data-palette-input]');
      const paletteEmpty = document.querySelector('[data-palette-empty]');
      const paletteOptions = [...document.querySelectorAll('[data-palette-list] [role="option"]')];
      if (palette && paletteInput) {
        const normalize = (text) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
        paletteOptions.forEach((option, index) => {
          option.id = `palette-option-${index}`;
          option.dataset.search = normalize(`${option.textContent} ${option.dataset.group} ${option.dataset.keywords ?? ''}`);
        });
        let activeIndex = 0;
        const visibleOptions = () => paletteOptions.filter((option) => !option.hidden);
        const setActive = (index) => {
          const options = visibleOptions();
          activeIndex = options.length ? (index + options.length) % options.length : 0;
          paletteOptions.forEach((option) => option.setAttribute('aria-selected', 'false'));
          const active = options[activeIndex];
          if (active) {
            active.setAttribute('aria-selected', 'true');
            active.scrollIntoView({ block: 'nearest' });
            paletteInput.setAttribute('aria-activedescendant', active.id);
          } else paletteInput.removeAttribute('aria-activedescendant');
        };
        const filterOptions = () => {
          const query = normalize(paletteInput.value.trim());
          paletteOptions.forEach((option) => { option.hidden = Boolean(query) && !query.split(/\s+/).every((word) => option.dataset.search.includes(word)); });
          if (paletteEmpty) paletteEmpty.hidden = visibleOptions().length > 0;
          setActive(0);
        };
        const runOption = async (option) => {
          if (!option) return;
          const { action, target } = option.dataset;
          palette.close();
          if (action === 'goto') document.querySelector(target)?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth' });
          if (action === 'project') openProject(target);
          if (action === 'link') window.open(target, '_blank', 'noreferrer');
          if (action === 'copy' && copyStatus) copyStatus.textContent = (await copyText(target)) ? 'Adresse e-mail copiée' : 'Copie impossible';
          if (action === 'game') document.querySelector('[data-game-open]')?.click();
        };
        const openPalette = () => {
          if (palette.open || document.querySelector('dialog[open]')) return;
          paletteInput.value = '';
          filterOptions();
          palette.showModal();
          paletteInput.focus();
        };
        paletteInput.addEventListener('input', filterOptions);
        paletteInput.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') { event.preventDefault(); setActive(activeIndex + 1); }
          if (event.key === 'ArrowUp') { event.preventDefault(); setActive(activeIndex - 1); }
          if (event.key === 'Enter') { event.preventDefault(); runOption(visibleOptions()[activeIndex]); }
        });
        paletteOptions.forEach((option) => {
          option.addEventListener('click', () => runOption(option));
          option.addEventListener('pointermove', () => setActive(visibleOptions().indexOf(option)));
        });
        palette.addEventListener('click', (event) => { if (event.target === palette) palette.close(); });
        document.querySelectorAll('[data-palette-open]').forEach((button) => button.addEventListener('click', openPalette));
        window.addEventListener('keydown', (event) => {
          const typing = event.target instanceof HTMLElement && event.target.matches('input, textarea, [contenteditable]');
          if ((event.key.toLowerCase() === 'k' && (event.ctrlKey || event.metaKey)) || (event.key === '/' && !typing)) {
            event.preventDefault();
            openPalette();
          }
        });
      }

      // Trace Run: easter egg opened from the footer.
      const gameDialog = document.querySelector('.game-dialog');
      const gameCanvas = document.querySelector('.cyber-game-canvas');
      const gameStart = document.querySelector('[data-game-start]');
      const gameScore = document.querySelector('[data-game-score]');
      const gameStatus = document.querySelector('[data-game-status]');

      if (gameDialog && gameCanvas && gameStart && gameScore && gameStatus) {
        const gameContext = gameCanvas.getContext('2d');
        const controls = new Set();
        const state = { active: false, score: 0, elapsed: 0, lastFrame: 0, player: { x: 0.5, y: 0.76 }, packets: [], ice: [], frame: 0, run: 0 };
        const randomPoint = () => ({ x: 0.12 + Math.random() * 0.76, y: 0.14 + Math.random() * 0.58 });
        const createIce = () => ({ x: 0.08 + Math.random() * 0.84, y: -0.08 - Math.random() * 0.35, drift: (Math.random() - 0.5) * 0.18, speed: 0.12 + Math.random() * 0.12 });

        const resetGame = () => {
          state.active = true;
          state.run += 1;
          const run = state.run;
          state.score = 0;
          state.elapsed = 0;
          state.lastFrame = performance.now();
          state.player = { x: 0.5, y: 0.76 };
          state.packets = Array.from({ length: 4 }, randomPoint);
          state.ice = Array.from({ length: 3 }, createIce);
          gameScore.textContent = '00';
          gameStatus.textContent = 'En cours';
          gameStart.textContent = 'Relancer';
          gameCanvas.focus({ preventScroll: true });
          requestAnimationFrame((time) => loop(time, run));
        };

        const resizeGame = () => {
          const bounds = gameCanvas.getBoundingClientRect();
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const targetWidth = Math.max(1, Math.round(bounds.width * ratio));
          const targetHeight = Math.max(1, Math.round(bounds.height * ratio));
          if (gameCanvas.width !== targetWidth || gameCanvas.height !== targetHeight) {
            gameCanvas.width = targetWidth;
            gameCanvas.height = targetHeight;
          }
          gameContext.setTransform(ratio, 0, 0, ratio, 0, 0);
          return { width: bounds.width, height: bounds.height };
        };

        const drawGame = () => {
          const { width, height } = resizeGame();
          gameContext.clearRect(0, 0, width, height);
          gameContext.fillStyle = '#0d141f';
          gameContext.fillRect(0, 0, width, height);
          gameContext.strokeStyle = 'rgba(159, 239, 0, .07)';
          gameContext.lineWidth = 1;
          for (let x = 0; x < width; x += 30) { gameContext.beginPath(); gameContext.moveTo(x, 0); gameContext.lineTo(x, height); gameContext.stroke(); }
          for (let y = 0; y < height; y += 30) { gameContext.beginPath(); gameContext.moveTo(0, y); gameContext.lineTo(width, y); gameContext.stroke(); }

          const toCanvas = (point) => ({ x: point.x * width, y: point.y * height });
          state.packets.forEach((packet) => {
            const point = toCanvas(packet);
            gameContext.fillStyle = '#9fef00'; gameContext.fillRect(point.x - 3, point.y - 3, 6, 6);
          });

          state.ice.forEach((ice) => {
            const point = toCanvas(ice);
            gameContext.beginPath(); gameContext.moveTo(point.x, point.y - 8); gameContext.lineTo(point.x + 8, point.y + 7); gameContext.lineTo(point.x - 8, point.y + 7); gameContext.closePath();
            gameContext.fillStyle = '#ff5c5c'; gameContext.fill();
          });

          const player = toCanvas(state.player);
          gameContext.fillStyle = '#9fef00'; gameContext.fillRect(player.x - 8, player.y - 8, 16, 16);
          gameContext.fillStyle = '#0d141f'; gameContext.fillRect(player.x - 3, player.y - 3, 6, 6);
          gameContext.fillStyle = 'rgba(159, 239, 0, .7)'; gameContext.font = '11px "JetBrains Mono", monospace'; gameContext.fillText(state.active ? `${Math.max(0, 30 - Math.ceil(state.elapsed)).toString().padStart(2, '0')} s` : 'Prêt', 12, height - 14);
        };

        const loop = (time, run) => {
          if (!state.active || run !== state.run) return;
          const delta = Math.min((time - state.lastFrame) / 1000, 0.05);
          state.lastFrame = time;
          state.frame = time;
          state.elapsed += delta;
          const horizontal = (controls.has('arrowright') || controls.has('d')) - (controls.has('arrowleft') || controls.has('a') || controls.has('q'));
          const vertical = (controls.has('arrowdown') || controls.has('s')) - (controls.has('arrowup') || controls.has('z') || controls.has('w'));
          state.player.x = Math.min(0.94, Math.max(0.06, state.player.x + horizontal * delta * 0.54));
          state.player.y = Math.min(0.9, Math.max(0.1, state.player.y + vertical * delta * 0.54));
          state.ice.forEach((ice) => { ice.y += ice.speed * delta; ice.x += ice.drift * delta; if (ice.y > 1.08 || ice.x < 0 || ice.x > 1) Object.assign(ice, createIce()); });
          state.packets.forEach((packet, index) => {
            if (Math.hypot(packet.x - state.player.x, packet.y - state.player.y) < 0.055) { state.score += 1; state.packets[index] = randomPoint(); gameScore.textContent = String(state.score).padStart(2, '0'); }
          });
          if (state.ice.some((ice) => Math.hypot(ice.x - state.player.x, ice.y - state.player.y) < 0.055) || state.elapsed >= 30) {
            state.active = false;
            gameStatus.textContent = `Terminé · ${state.score} paquets`;
            gameStart.textContent = 'Rejouer';
          }
          drawGame();
          if (state.active) requestAnimationFrame((nextTime) => loop(nextTime, run));
        };

        const movementKeys = new Set(['arrowleft', 'arrowright', 'arrowup', 'arrowdown', 'a', 'd', 'q', 's', 'w', 'z']);
        window.addEventListener('keydown', (event) => {
          const key = event.key.toLowerCase();
          if (state.active && gameDialog.open && movementKeys.has(key)) { event.preventDefault(); controls.add(key); }
        });
        window.addEventListener('keyup', (event) => controls.delete(event.key.toLowerCase()));
        gameStart.addEventListener('click', resetGame);
        gameCanvas.addEventListener('click', () => { if (!state.active) resetGame(); });
        document.querySelectorAll('[data-game-direction]').forEach((button) => {
          const direction = { left: 'arrowleft', right: 'arrowright', up: 'arrowup', down: 'arrowdown' }[button.dataset.gameDirection];
          button.addEventListener('pointerdown', (event) => { event.preventDefault(); if (!state.active) resetGame(); controls.add(direction); });
          ['pointerup', 'pointerleave', 'pointercancel'].forEach((type) => button.addEventListener(type, () => controls.delete(direction)));
        });

        document.querySelector('[data-game-open]')?.addEventListener('click', () => { gameDialog.showModal(); drawGame(); });
        document.querySelector('[data-game-close]')?.addEventListener('click', () => gameDialog.close());
        gameDialog.addEventListener('close', () => { state.active = false; state.run += 1; controls.clear(); gameStatus.textContent = 'Prêt'; gameStart.textContent = 'Lancer'; });
      }
    </script>
  </body>
</html>
